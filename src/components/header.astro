---
// Header: logo + navegación (desktop) + idiomas (desktop) + toggle (móvil)
import { defaultLang, languages } from "@i18n/ui";
import LogoHeader from "./header/logo-header.astro";
import NavMenuHeader from "./header/nav-menu-header.astro";
import ToggleHeader from "./header/toggle-header.astro";

export interface Props {
  lang?: "ca" | "es" | "en";
}

const { lang = defaultLang } = Astro.props;

// Construye la URL para cambiar de idioma manteniendo la página actual
function langUrl(code: string): string {
  const path = Astro.url.pathname;
  if (code === defaultLang) {
    return path.replace(/^\/(es|en)(\/|$)/, "/");
  }
  const cleanPath = path.replace(/^\/(es|en)(\/|$)/, "/");
  return `/${code}${cleanPath}`;
}
---

<header>
  <LogoHeader lang={lang} />
  <NavMenuHeader lang={lang} />
  <nav class="lang-list" aria-label="Selector de idioma">
    {
      Object.entries(languages).map(([code, label]) => (
        <a
          href={langUrl(code)}
          class={code === lang ? "active" : ""}
        >
          [{label}]
        </a>
      ))
    }
  </nav>
  <ToggleHeader lang={lang} />
</header>

<style>
  header {
    width: 100%;
    height: 48px;
    background-color: var(--light-gray);
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    padding: 0 16px;
  }

  .lang-list {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    white-space: nowrap;

    a {
      text-decoration: none;
      color: var(--black);
      padding: 2px 4px;

      &.active {
        background-color: var(--green);
        color: var(--white);
      }

      &:hover {
        background-color: var(--green);
        color: var(--black);
      }
    }
  }

  @media (width < 1366px) {
    header {
      display: flex;
      justify-content: space-between;
    }

    .lang-list {
      display: none;
    }
  }
</style>
