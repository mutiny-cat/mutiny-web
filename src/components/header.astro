---
import { Icon } from "astro-icon/components";
import { useTranslations } from "../i18n/utils";
import { defaultLang } from "../i18n/ui";
import { headerMenuOptions } from "@data/menu-options";
import MenuOption from "./ui/menu-item.astro";

export interface Props {
  lang?: "ca" | "es" | "en";
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<header>
  <div class="logo">
    <a href="/" aria-label="Inici">
      <Icon name="logo-mutiny" />
    </a>
  </div>
  <nav class="menu-bar" aria-label="Principal">
    <ul>
      {
        headerMenuOptions.map((opt) => {
          const label = t(opt.labelKey);
          if (opt.children && opt.children.length > 0) {
            return (
              <li class="top-item">
                <MenuOption
                  text={label}
                  keyIndex={opt.keyIndex}
                  class="top-trigger"
                />
                <div class="dropdown" role="menu" aria-label={label}>
                  <ul>
                    {opt.children.map((child) => {
                      if (child.separator) {
                        return <li class="dropdown-sep" role="separator" />;
                      }
                      if (child.children && child.children.length > 0) {
                        return (
                          <li class="sub-item">
                            <MenuOption
                              text={t(child.labelKey)}
                              keyIndex={child.keyIndex ?? 0}
                              class="dropdown-link sub-trigger"
                              href="#"
                            />
                            <div class="sub-flyout" role="menu">
                              <ul>
                                {child.children.map((sub) => {
                                  if (sub.separator) {
                                    return (
                                      <li
                                        class="dropdown-sep"
                                        role="separator"
                                      />
                                    );
                                  }
                                  return (
                                    <li>
                                      <MenuOption
                                        text={t(sub.labelKey)}
                                        keyIndex={sub.keyIndex ?? 0}
                                        href={sub.href}
                                        class="dropdown-link"
                                      />
                                    </li>
                                  );
                                })}
                              </ul>
                            </div>
                          </li>
                        );
                      }
                      return (
                        <li>
                          <MenuOption
                            text={t(child.labelKey)}
                            keyIndex={child.keyIndex ?? 0}
                            href={child.href}
                            class="dropdown-link"
                          />
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </li>
            );
          }
          return (
            <li class="top-item">
              <MenuOption
                text={label}
                keyIndex={opt.keyIndex}
                href={opt.href}
                class="top-link"
              />
            </li>
          );
        })
      }
    </ul>
  </nav>
  <div class="toggle" aria-label="Menú" role="button" tabindex="0">
    <Icon name="heroicons:bars-3" />
  </div>
</header>

<style>
  header {
    background-color: var(--light-gray);
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    padding: 0 16px;
  }

  .logo {
    display: flex;
    align-items: center;
    line-height: 0;

    svg {
      width: 48px;
      height: auto;
      color: var(--red);
    }
  }

  .toggle {
    display: none;
  }

  @media (max-width: 767px) {
    .toggle {
      display: block;
    }
  }

  .menu-bar {
    padding: 0 16px;

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      padding: 0;
    }
  }

  .top-item {
    position: relative;
  }

  .top-link,
  .top-trigger {
    display: flex;
    align-items: center;
    padding: 8px 0;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    line-height: 1.4;
    white-space: nowrap;
  }

  :global(.top-item.open .top-trigger) {
    background: var(--green);
    cursor: var(--cursor-dos-magenta);
  }

  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: max-content;
    padding: 8px 16px;
    z-index: 60;
    background: var(--light-gray);
    box-shadow: 16px 16px 0 var(--black);
  }

  .top-item.open .dropdown {
    display: block;
  }

  .dropdown ul {
    display: flex;
    flex-direction: column;
    background: var(--light-gray);
    border: 2px solid var(--black);
    padding: 8px;
  }

  .dropdown .dropdown-link {
    display: flex;
    padding: 4px 16px;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    line-height: 1.4;
    white-space: nowrap;
  }

  .sub-item {
    position: relative;
  }

  .sub-trigger {
    cursor: pointer;
  }

  .sub-item.open .sub-trigger {
    background: var(--green);
  }

  .sub-flyout {
    display: none;
    position: absolute;
    left: 100%;
    top: -10px;
    z-index: 70;
    background: var(--light-gray);
    box-shadow: 10px 10px 0 var(--black);
    padding: 8px 16px;
  }

  .sub-item.open .sub-flyout {
    display: block;
  }

  .sub-flyout ul {
    display: flex;
    flex-direction: column;
    background: var(--light-gray);
    border: 2px solid var(--black);
    padding: 8px;
  }

  .sub-flyout .dropdown-link {
    padding: 4px 16px;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    line-height: 1.4;
    white-space: nowrap;
  }

  .sub-flyout .dropdown-sep {
    height: 2px;
    margin: 8px -8px;
    background: var(--border-dark);
  }

  .dropdown-sep {
    height: 2px;
    margin: 8px -8px;
    background: var(--border-dark);
  }
</style>

<script>
  const triggers = document.querySelectorAll(".top-trigger");
  const dropdowns = document.querySelectorAll(".dropdown");
  const subTriggers = document.querySelectorAll(".sub-trigger");

  function closeAll() {
    triggers.forEach((t) => t.parentElement?.classList.remove("open"));
    subTriggers.forEach((s) => s.parentElement?.classList.remove("open"));
  }

  triggers.forEach((t) => {
    t.addEventListener("click", (e) => {
      e.stopPropagation();
      const li = t.parentElement!;
      if (li.classList.contains("open")) {
        closeAll();
      } else {
        closeAll();
        li.classList.add("open");
      }
    });
  });

  subTriggers.forEach((s) => {
    s.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      const li = s.parentElement!;
      if (li.classList.contains("open")) {
        li.classList.remove("open");
      } else {
        subTriggers.forEach((st) => st.parentElement?.classList.remove("open"));
        li.classList.add("open");
      }
    });
  });

  dropdowns.forEach((d) => {
    d.addEventListener("click", (e) => {
      e.stopPropagation();
    });
  });

  document.querySelectorAll(".sub-flyout").forEach((sf) => {
    sf.addEventListener("click", (e) => {
      e.stopPropagation();
    });
  });

  document.addEventListener("click", closeAll);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });
</script>
