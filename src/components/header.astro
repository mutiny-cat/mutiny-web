---
// Header: logo + navegación (desktop) + idioma activo (desktop) + toggle (móvil)
import { defaultLang, languages } from "@i18n/ui";
import LogoHeader from "./header/logo-header.astro";
import NavMenuHeader from "./header/nav-menu-header.astro";
import ToggleHeader from "./header/toggle-header.astro";

export interface Props {
  lang?: "ca" | "es" | "en";
}

const { lang = defaultLang } = Astro.props;
---

<header>
  <LogoHeader lang={lang} />
  <NavMenuHeader lang={lang} />
  <div class="lang-shortcut" id="f11-trigger">
    [{languages[lang]}]
  </div>
  <ToggleHeader lang={lang} />
</header>

<style>
  header {
    width: 100%;
    height: 48px;
    background-color: var(--light-gray);
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    padding: 0 16px;
  }

  .lang-shortcut {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    white-space: nowrap;
    cursor: pointer;
  }

  @media (width < 1366px) {
    header {
      display: flex;
      justify-content: space-between;
    }

    .lang-shortcut {
      display: none;
    }
  }
</style>

<script>
  // Click en el indicador de idioma abre el modal de idiomas
  document.getElementById("f11-trigger")?.addEventListener("click", () => {
    document.getElementById("lang-modal")?.classList.toggle("open");
  });
</script>
