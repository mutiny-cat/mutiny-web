---
import { Icon } from 'astro-icon/components';
import { languages, defaultLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang?: 'ca' | 'es' | 'en';
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer role="contentinfo">
  <div class="wrapper">
    <div class="shortcuts"><span class="f10">F10</span>&nbsp;Men&uacute;&nbsp;&nbsp;<span class="f11">F11</span>&nbsp;Idiomes&nbsp;[{languages[lang]}]</div>
    <div class="credit">
      <Icon name="simple-icons:creativecommons" aria-label="Creative Commons" />
      <span>{t('footer.year')}{currentYear})</span>
    </div>
  </div>

  <div class="lang-modal-overlay" id="lang-modal" aria-hidden="true">
    <div class="lang-modal">
      <div class="lang-modal-title">Idiomes</div>
      <ul>
        {Object.entries(languages).map(([code, label]) => (
          <li>
            <a href={code === defaultLang ? '/' : `/${code}/`} class={code === lang ? 'active' : ''}>
              {code === lang ? '\u25ba ' : '  '}{label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<script>
  const modal = document.getElementById('lang-modal')!;
  document.addEventListener('keydown', (e) => {
    if (e.key === 'F11') {
      e.preventDefault();
      modal.setAttribute('aria-hidden', modal.getAttribute('aria-hidden') === 'false' ? 'true' : 'false');
    }
    if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
      modal.setAttribute('aria-hidden', 'true');
    }
  });
  modal.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).classList.contains('lang-modal-overlay')) {
      modal.setAttribute('aria-hidden', 'true');
    }
  });
</script>

<style>
  footer {
    background-color: var(--light-gray);
  }

  .wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding-inline: 24px;
  }

  .credit {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-self: end;
    padding-block: 8px;
    white-space: nowrap;

    svg {
      width: 1.2em;
      height: 1.2em;
    }
  }

  .shortcuts {
    justify-self: start;
    padding-block: 8px;
    white-space: nowrap;
  }

  .f10, .f11 {
    color: var(--red);
  }

  .lang-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .lang-modal-overlay[aria-hidden="true"] {
    display: none;
  }

  .lang-modal {
    background: var(--menu-bg);
    border: 1px solid var(--dark-gray);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.3);
    padding: 0;
    min-width: 200px;
  }

  .lang-modal-title {
    background: var(--menu-bg);
    padding: 4px 16px;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    font-weight: 700;
    border-bottom: 1px solid var(--dark-gray);
  }

  .lang-modal ul {
    list-style: none;
    padding: 2px 0;
  }

  .lang-modal a {
    display: block;
    padding: 4px 16px;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    color: #000;
    text-decoration: none;
    cursor: var(--cursor-dos);
  }

  .lang-modal a:hover,
  .lang-modal a:focus-visible {
    background: var(--blue);
    color: var(--white);
    outline: none;
  }

  .lang-modal a.active {
    font-weight: 700;
  }
</style>
