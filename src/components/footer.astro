---
// Footer con atajos de teclado F10/F11, selector de idiomas y créditos Creative Commons
import { Icon } from "astro-icon/components";
import { languages, defaultLang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

export interface Props {
  lang?: "ca" | "es" | "en";
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<!-- Pie de página con atajos de teclado, créditos y modal de selección de idioma -->
<footer role="contentinfo">
  <div class="wrapper">
    <!-- Atajos de teclado: F10 para menú, F11 para idiomas -->
    <div class="shortcuts">
      <button class="fkey" data-action="menu">
        <span class="fkey-label">F10</span>
        <span>Menú</span>
      </button>
      <button class="fkey" data-action="lang">
        <span class="fkey-label">F11</span>
        <span>Idiomes [{languages[lang]}]</span>
      </button>
    </div>
    <!-- Créditos con icono Creative Commons y año actual -->
    <div class="credit">
      <Icon name="simple-icons:creativecommons" aria-label="Creative Commons" />
      <span>{t("footer.year")}{currentYear})</span>
    </div>
  </div>

  <!-- Modal overlay del selector de idiomas (se activa con F11) -->
  <div class="lang-modal-overlay" id="lang-modal" aria-hidden="true">
    <div class="lang-modal">
      <div class="lang-modal-title">Idiomes</div>
      <ul>
        {
          Object.entries(languages).map(([code, label]) => (
            <li>
              <a
                href={code === defaultLang ? "/" : `/${code}/`}
                class={code === lang ? "active" : ""}
              >
                {code === lang ? "\u25ba " : "  "}
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Footer con fondo gris claro */
  footer {
    background-color: var(--light-gray);
  }

  /* Grid de 2 columnas: atajos a la izquierda, créditos a la derecha */
  .wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding-inline: 24px;
  }

  /* Créditos alineados a la derecha con icono CC */
  .credit {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-self: end;
    padding-block: 8px;
    white-space: nowrap;

    svg {
      width: 1.2em;
      height: 1.2em;
    }
  }

  /* Atajos de teclado alineados a la izquierda */
  .shortcuts {
    justify-self: start;
    padding: 8px 0 0;
    white-space: nowrap;
    display: flex;
    gap: 16px;
  }
  
  /* Botones que simulan teclas de función (F10, F11) */
  .fkey {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    line-height: inherit;
    display: flex;
    gap: 0;
  }
  
  /* Etiqueta de la tecla en rojo */
  .fkey-label {
    color: var(--red);
    padding-right: 6px;
  }

  /* Overlay del modal de idiomas: centrado en pantalla */
  .lang-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Oculto cuando aria-hidden="true" */
  .lang-modal-overlay[aria-hidden="true"] {
    display: none;
  }

  /* Ventana modal con sombra estilo DOS */
  .lang-modal {
    background: var(--menu-bg);
    border: 1px solid var(--dark-gray);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.3);
    padding: 0;
    min-width: 200px;
  }

  /* Título de la ventana modal */
  .lang-modal-title {
    background: var(--menu-bg);
    padding: 4px 16px;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    font-weight: 700;
    border-bottom: 1px solid var(--dark-gray);
  }

  .lang-modal ul {
    list-style: none;
    padding: 2px 0;
  }

  /* Enlaces de idioma con resaltado azul al hover */
  .lang-modal a {
    display: block;
    padding: 4px 16px;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    color: #000;
    text-decoration: none;
    cursor: pointer;
  }

  .lang-modal a:hover,
  .lang-modal a:focus-visible {
    background: var(--blue);
    color: var(--white);
    outline: none;
  }

  /* Idioma actual en negrita */
  .lang-modal a.active {
    font-weight: 700;
  }
</style>

<script>
  // Modal de selección de idioma y atajos de teclado globales
  const modal = document.getElementById("lang-modal")!;

  // Gestiona los atajos: F10 → foco en nav, F11 → toggle modal de idiomas
  function handleShortcut(action: string) {
    if (action === "lang") {
      const isHidden = modal.getAttribute("aria-hidden") === "true";
      modal.setAttribute("aria-hidden", isHidden ? "false" : "true");
    }
    if (action === "menu") {
      const firstLink = document.querySelector("nav a");
      if (firstLink instanceof HTMLElement) {
        firstLink.focus();
      }
    }
  }

  // Atajos de teclado: F10 (menú), F11 (idiomas), Escape (cerrar modal)
  document.addEventListener("keydown", (e) => {
    if (e.key === "F10") {
      e.preventDefault();
      handleShortcut("menu");
    }
    if (e.key === "F11") {
      e.preventDefault();
      handleShortcut("lang");
    }
    if (e.key === "Escape" && modal.getAttribute("aria-hidden") === "false") {
      modal.setAttribute("aria-hidden", "true");
    }
  });

  // Click en los botones de tecla de función
  document.querySelectorAll(".fkey").forEach((btn) => {
    btn.addEventListener("click", () => {
      const action = (btn as HTMLElement).dataset.action;
      if (action) handleShortcut(action);
    });
  });

  // Click fuera del modal → cerrar
  modal.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).classList.contains("lang-modal-overlay")) {
      modal.setAttribute("aria-hidden", "true");
    }
  });

  // Guarda la preferencia de idioma en localStorage al hacer click en un enlace
  modal.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      const href = link.getAttribute("href");
      if (href === "/") {
        localStorage.setItem("lang", "ca");
      } else {
        const match = href?.match(/^\/(es|en)\//);
        if (match) localStorage.setItem("lang", match[1]);
      }
    });
  });
</script>
