---
// Footer simplificado: solo créditos CC + año
import { Icon } from "astro-icon/components";
import { useTranslations } from "@i18n/utils";
import KeyFunction from "./ui/key-function.astro";

export interface Props {
  lang?: "ca" | "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer role="contentinfo">
  <div class="footer-wrapper">
    <div class="footer-left">
      <span class="footer-help">{t("footer.help")}</span>
      <KeyFunction key="F11" label={t("modal.languages.heading")} />
    </div>
    <div class="footer-credit">
      <Icon name="simple-icons:creativecommons" aria-label="Creative Commons" />
      <span>{t("footer.year")}{currentYear})</span>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: var(--light-gray);
  }

  .footer-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 8px;
    padding-inline: 24px;
  }

  .footer-help {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    white-space: nowrap;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (width < 1366px) {
    .footer-left {
      display: none;
    }

    .footer-wrapper {
      justify-content: center;
    }
  }

  .footer-credit {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    white-space: nowrap;

    svg {
      width: 1.2em;
      height: 1.2em;
    }
  }
</style>
