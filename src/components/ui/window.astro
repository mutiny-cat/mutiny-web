---
// Ventana reutilizable estilo DOS/Turbo Vision con doble borde blanco
// Usada por: modal-menu (pantalla completa), modal-home (centrado), modal-languages (centrado)
import CloseButton from "./close-button.astro";

export interface Props {
  variant?: "fullscreen" | "centered";
  background?: string;
  modalId?: string;
  title?: string;
}

const {
  variant = "centered",
  background = "var(--light-gray)",
  modalId = "",
  title = "",
} = Astro.props;
---

<div
  id={modalId || undefined}
  class={`window window--${variant}`}
  style={`background-color: ${background};`}
>
  <div class="window-frame">
    <CloseButton />
    {
      title && (
        <span class="window-title">{title}</span>
      )
    }
    <div class="window-content">
      <slot />
    </div>
  </div>
</div>

<style>
  .window {
    display: none;

    &.open {
      display: block;
    }
  }

  .window--fullscreen {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    padding: 24px 16px 48px;

    .window-frame {
      height: 100%;
    }

    .window-content {
      height: 100%;
    }
  }

  .window--centered {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: var(--z-modal);
    padding: 8px;
    box-shadow: 16px 16px 0 var(--black);
    color: var(--white);

    &.open {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .window-frame {
      height: auto;
      width: auto;
      min-width: 320px;
      max-height: 80vh;
      overflow: visible;
    }

    .window-content {
      /* overflow-y: auto; */
      max-height: 70vh;
      padding: 24px 0 0;
    }
  }

  .window-frame {
    position: relative;
    width: 100%;
    border: 8px double var(--white);
  }

  .window-title {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 700;
    color: var(--white);
    background: var(--light-gray);
    padding: 0 16px;
    white-space: nowrap;
    line-height: 1;
  }

  .window-content {
    /* overflow-y: scroll; */
    padding: 16px 0 16px 4px;
  }
</style>
