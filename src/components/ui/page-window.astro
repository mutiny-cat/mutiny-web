---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="page-window">
  <div class="window-frame">
    <header class="window-header">
      <span class="window-marker" aria-hidden="true">■</span>
      <h2 class="window-title">{title}</h2>
      <span class="window-marker" aria-hidden="true">&nbsp;</span>
    </header>
    <div class="window-body">
      <slot />
    </div>
  </div>
</div>

<style>
  .page-window {
    background-color: var(--light-gray);
    color: var(--black);
    padding: 8px;
    max-width: 900px;
    margin: 64px auto;
  }

  .window-frame {
    border: 8px double var(--white);
    padding: 64px 32px;
    position: relative;
  }

  .window-header {
    position: absolute;
    top: -20px;
    inset-inline: 16px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    background: var(--light-gray);
  }

  .window-marker {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    color: var(--light-green);
  }

  .window-title {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    font-weight: 700;
    text-align: center;
    color: var(--white);
    background: var(--light-gray);
    padding: 0 16px;
    max-inline-size: fit-content;
    margin-inline: auto;
  }

  .window-body {
    font-family: var(--font-mono);
    font-size: var(--font-size);
  }
</style>
