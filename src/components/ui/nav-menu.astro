---
import { useTranslations } from "../../i18n/utils";
import { defaultLang } from "../../i18n/ui";
import { headerMenuOptions } from "@data/menu-options";
import MenuOption from "./menu-item.astro";

export interface Props {
  lang?: "ca" | "es" | "en";
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

// Prefija la URL con el código de idioma (/es/, /en/) si no es catalán
function localizeHref(href: string): string {
  if (lang === defaultLang) return href;
  return `/${lang}${href}`;
}
---

<nav class="menu-bar" aria-label="Principal">
  <ul>
    {
      headerMenuOptions.map((opt) => {
        const label = t(opt.labelKey);

        // Item con submenú dropdown
        if (opt.children && opt.children.length > 0) {
          return (
            <li class="top-item">
              <MenuOption
                text={label}
                keyIndex={opt.keyIndex}
                class="top-trigger"
              />

              <div class="dropdown" role="menu" aria-label={label}>
                <ul>
                  {opt.children.map((child) => {
                    // Separador visual dentro del dropdown
                    if (child.separator) {
                      return <li class="dropdown-sep" role="separator" />;
                    }

                    // Enlace normal dentro del dropdown
                    return (
                      <li>
                        <MenuOption
                          text={t(child.labelKey)}
                          keyIndex={child.keyIndex ?? 0}
                          href={
                            child.href
                              ? localizeHref(child.href)
                              : undefined
                          }
                          class="dropdown-link"
                        />
                      </li>
                    );
                  })}
                </ul>
              </div>
            </li>
          );
        }

        // Item de enlace directo (sin submenú)
        return (
          <li class="top-item">
            <MenuOption
              text={label}
              keyIndex={opt.keyIndex}
              href={opt.href ? localizeHref(opt.href) : undefined}
              class="top-link"
            />
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  /* Barra de menú horizontal con los items en fila */
  .menu-bar {
    padding: 0 16px;

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      padding: 0;
    }
  }

  /* Cada item de primer nivel usa position relative para el dropdown */
  .top-item {
    position: relative;
  }

  /* Estilo común para enlaces directos y triggers de dropdown */
  .top-link,
  .top-trigger {
    display: flex;
    align-items: center;
    padding: 8px 0;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    white-space: nowrap;
  }

  /* Trigger activo: fondo verde */
  :global(.top-item.open .top-trigger) {
    background: var(--green);
    cursor: pointer;
  }

  /* Dropdown: oculto por defecto, se muestra al abrir el item padre */
  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: max-content;
    padding: 8px 16px;
    z-index: 60;
    background: var(--light-gray);
    box-shadow: 16px 16px 0 var(--black);
  }

  .top-item.open .dropdown {
    display: block;
  }

  /* Lista interior del dropdown: columna con borde negro */
  .dropdown ul {
    display: flex;
    flex-direction: column;
    background: var(--light-gray);
    border: 2px solid var(--black);
    padding: 8px;
  }

  /* Enlaces del dropdown: ocupan todo el ancho para hover completo */
  .dropdown .dropdown-link {
    display: block;
    padding: 4px 16px;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    white-space: nowrap;
  }

  /* Separador visual entre grupos de opciones */
  .dropdown-sep {
    height: 2px;
    margin: 8px -8px;
    background: var(--border-dark);
  }
</style>

<script>
  const triggers = document.querySelectorAll(".top-trigger");
  const dropdowns = document.querySelectorAll(".dropdown");

  // Cierra todos los dropdowns abiertos
  function closeAll() {
    triggers.forEach((t) => t.parentElement?.classList.remove("open"));
  }

  // Click en trigger: toggle del dropdown (abre uno, cierra los demás)
  triggers.forEach((t) => {
    t.addEventListener("click", (e) => {
      e.stopPropagation();
      const li = t.parentElement!;
      if (li.classList.contains("open")) {
        closeAll();
      } else {
        closeAll();
        li.classList.add("open");
      }
    });
  });

  // Evita que el click dentro del dropdown cierre el menú
  dropdowns.forEach((d) => {
    d.addEventListener("click", (e) => {
      e.stopPropagation();
    });
  });

  // Click fuera del menú o tecla Escape: cierra todo
  document.addEventListener("click", closeAll);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });
</script>
