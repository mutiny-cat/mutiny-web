---
// Botón de cierre decorativo con corchetes [■] estilo DOS/Turbo Vision
// Se posiciona de forma absoluta respecto a su contenedor (que debe tener position: relative)
export interface Props {
  top?: string;
  left?: string;
}

const { top = "-14px", left = "16px" } = Astro.props;
---

<button
  class="close"
  style={`top: ${top}; left: ${left};`}
  aria-hidden="true"
  data-close
>
  ■
</button>

<style>
  /* Botón decorativo: cuadrado verde entre corchetes blancos */
  .close {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 24px;
    color: var(--light-green);
    box-shadow: none;
    padding: 0;
    background: var(--light-gray);
    line-height: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;

    /* Corchete izquierdo [ */
    &::before {
      content: "[";
      font-family: var(--font-mono);
      font-size: 24px;
      color: var(--white);
    }

    /* Corchete derecho ] */
    &::after {
      font-family: var(--font-mono);
      font-size: 24px;
      content: "]";
      color: var(--white);
    }
  }
</style>
