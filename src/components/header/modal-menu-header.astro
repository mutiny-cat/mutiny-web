---
// Modal de menú para móvil/tablet: ocupa toda la pantalla con acordeón de opciones
import { useTranslations } from "@i18n/utils";
import { defaultLang } from "@i18n/ui";
import { headerMenuOptions } from "@data/menu-options";
import MenuOption from "@components/ui/menu-item.astro";

export interface Props {
  lang?: "ca" | "es" | "en";
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

// Añade el prefijo de idioma a las URLs si no es el idioma por defecto
function localizeHref(href: string): string {
  if (lang === defaultLang) return href;
  return `/${lang}${href}`;
}
---

<!-- Modal overlay: cubre toda la pantalla -->
<div class="modal" id="main-modal">

  <!-- Marco con doble borde blanco -->
  <div class="modal-border">

    <!-- Botón de cierre: [■] sobre el borde superior -->
    <button class="close" aria-hidden="true" data-close>■</button>

    <!-- Contenido del menú -->
    <div class="modal-menu">
      <ul>
        {
          headerMenuOptions.map((opt) => {
            const label = t(opt.labelKey);

            {/* Opción con submenú */}
            if (opt.children && opt.children.length > 0) {
              return (
                <li>
                  <button>
                    <MenuOption text={label} keyIndex={opt.keyIndex} /> <span aria-hidden="true">▾</span>
                  </button>
                  <ul hidden>
                    {opt.children.map((child) => {
                      if (child.separator) {
                        return <li class="modal-sep" role="separator" />;
                      }
                      return (
                        <li>
                          <MenuOption
                            text={t(child.labelKey)}
                            keyIndex={child.keyIndex ?? 0}
                            href={child.href ? localizeHref(child.href) : undefined}
                          />
                        </li>
                      );
                    })}
                  </ul>
                </li>
              );
            }

            {/* Opción de enlace directo */}
            return (
              <li>
                <MenuOption
                  text={label}
                  keyIndex={opt.keyIndex}
                  href={opt.href ? localizeHref(opt.href) : undefined}
                />
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</div>

<style>
  /* Overlay del modal: oculto por defecto, se activa con la clase .open */
  .modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background-color: var(--light-gray);
    padding: 24px;

    /* Al abrirse, centra el contenido con flex */
    &.open {
      display: flex;
      justify-content: center;
      align-items: center;
    }
  }

  /* Marco decorativo con doble borde blanco */
  .modal-border {
    position: relative;
    width: 100%;
    height: 100%;
    border: 8px double var(--white);
    padding: 24px;

    /* Botón de cierre con corchetes decorativos [■] */
    .close {
      position: absolute;
      top: -14px;
      left: 16px;
      font-family: var(--font-mono);
      font-size: 24px;
      color: var(--light-green);
      box-shadow: none;
      padding: 0;
      background: var(--light-gray);
      line-height: 1;
      min-width: 0;
      display: flex;
      justify-content: center;
      align-items: center;

      /* Corchete izquierdo [ */
      &::before {
        content: "[";
        font-family: var(--font-mono);
        font-size: 24px;
        color: var(--white);
      }

      /* Corchete derecho ] */
      &::after {
        font-family: var(--font-mono);
        font-size: 24px;
        content: "]";
        color: var(--white);
      }
    }
  }

  /* Contenido del menú con fuente grande y botones de acordeón */
  .modal-menu {
    font-size: 20px;
        
    /* Botones que expanden/colapsan submenús */
    button {
      font-size: 20px;
      font-family: var(--font-mono);
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      height: 48px;
    }

    span {
      padding: 0;
    }

    a {
      margin: 0;
      padding: 0;
    }

  }
</style>

<script>
  // Acordeón del modal: solo un submenú abierto a la vez
  const buttons = document.querySelectorAll(".modal-menu button");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const ul = btn.nextElementSibling;

      // Cierra todos los demás submenús antes de abrir el actual
      buttons.forEach((otherBtn) => {
        const otherUl = otherBtn.nextElementSibling;
        if (otherUl !== ul && otherUl instanceof HTMLUListElement) {
          otherUl.hidden = true;
        }
      });

      // Alterna la visibilidad del submenú clickeado
      if (ul instanceof HTMLUListElement) {
        ul.hidden = !ul.hidden;
      }
    });
  });
</script>
