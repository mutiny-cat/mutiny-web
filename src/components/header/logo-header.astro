---
import { Icon } from "astro-icon/components";
import { defaultLang } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";

export interface Props {
  lang?: "ca" | "es" | "en";
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<div>
  <a href={lang === defaultLang ? "/" : `/${lang}/`} aria-label={t("logo.ariaLabel.header")}>
    <Icon name="logo-mutiny" />
  </a>
</div>

<style>
  div {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 16px;
    width: 48px;
    height: 48px;

    @media (width < 1068px) {
      padding: 16px 0;
    }

    a {
      display: block;
      transition: background-color 0.15s;
      
      &:hover,
      &:focus-visible,
      &:active {
        background-color: var(--green);
      }
    }

    svg {
      display: block;
      width: 32px;
      height: auto;
      color: var(--red);
    }
  }

  div:hover {
    background-color: var(--green);
    cursor: pointer;
  }
</style>