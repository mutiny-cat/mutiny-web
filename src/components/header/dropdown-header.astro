---
// Dropdown que se muestra al hacer hover en opciones del menú con submenú
import MenuOption from "@components/ui/menu-item.astro";

export interface Props {
  label: string;
  items: {
    labelKey?: string;
    text?: string;
    href?: string;
    keyIndex?: number;
    separator?: boolean;
  }[];
}

const { label, items } = Astro.props;
---

<!-- Contenedor del dropdown: se posiciona debajo de la opción padre -->
<div class="dropdown" role="menu" aria-label={label}>
  <div class="border">
    <ul>
      {
        items.map((item) => {
          // Separador visual entre grupos de opciones
          if (item.separator) {
            return <li class="dropdown-sep" role="separator" />;
          }
          // Ítem normal del dropdown
          return (
            <li>
              <MenuOption
                text={item.text ?? ""}
                keyIndex={item.keyIndex ?? 0}
                href={item.href}
                class="dropdown-link"
              />
            </li>
          );
        })
      }
    </ul>
  </div>
</div>

<style>
  /* Oculto por defecto, se muestra con hover en el <li> padre */
  .dropdown {
    display: none;
    position: absolute;
    z-index: var(--z-dropdown);
    background: var(--light-gray);
    box-shadow: 16px 16px 0 var(--black);
    height: auto;
    padding: 16px;
  }

  /* Lista vertical con borde negro */
  ul {
    border: 2px solid var(--black);
    display: flex;
    flex-direction: column;
  }

  /* Separador entre grupos dentro del dropdown */
  .dropdown-sep {
    height: 2px;
    background: var(--border-dark);
  }

  /* Solo en escritorio con ratón: mostrar dropdown al hacer hover en el <li> */
  @media (min-width: 1366px) and (pointer: fine) {
    :global(li):hover .dropdown {
      display: block;
    }
  }
</style>
