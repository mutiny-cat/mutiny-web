---
import { Icon } from "astro-icon/components";
import { defaultLang } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";

export interface Props {
  lang?: "ca" | "es" | "en";
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<div>
  <button id="open-menu" aria-label={t("toggle.ariaLabel.open.header")} aria-expanded="false" aria-controls="main-menu" aria-haspopup="menu">
    <Icon name="toggle" />
  </button>
</div>

<style>
  div {
    display: none;
    
    @media (width < 1068px) {
      display: block;

      button {
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 0;
        height: 48px;
        width: 48px;
        transition: background-color 0.15s;
  
        &:hover,
        &:focus-visible,
        &:active {
          background-color: var(--green);
        }
      }

      svg {
        display: block;
        width: 32px;
        height: auto;
        color: var(--red);
      }
    }
  }
</style>