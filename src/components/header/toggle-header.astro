---
import { Icon } from "astro-icon/components";
import { defaultLang } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";

export interface Props {
  lang?: "ca" | "es" | "en";
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<div>
  <button id="open-menu" aria-label={t("toggle.ariaLabel.open.header")} aria-expanded="false" aria-controls="main-menu" aria-haspopup="menu">
    <Icon name="toggle" />
  </button>
</div>

<style>
  div {
    display: none;
    
    @media (width < 1068px) {
      display: block;

      button {
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 0;
        height: 48px;
        width: 48px;
        transition: background-color 0.15s;
  
        &:hover,
        &:focus-visible,
        &:active {
          background-color: var(--green);
        }
      }

      svg {
        display: block;
        width: 32px;
        height: auto;
        color: var(--red);
      }
    }
  }
</style>

<script>
  const btn = document.getElementById("open-menu");
  const modal = document.getElementById("main-modal");

  function openMenu() {
    modal?.classList.add("open");
    document.body.style.overflow = "hidden";
    if (btn instanceof HTMLButtonElement) {
      btn.setAttribute("aria-expanded", "true");
    }
  }

  function closeMenu() {
    modal?.classList.remove("open");
    document.body.style.overflow = "";
    if (btn instanceof HTMLButtonElement) {
      btn.setAttribute("aria-expanded", "false");
    }
  }

  btn?.addEventListener("click", openMenu);

  modal?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).classList.contains("modal")) {
      closeMenu();
    }
  });

  modal?.querySelector("[data-close]")?.addEventListener("click", closeMenu);

  modal?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal?.classList.contains("open")) {
      closeMenu();
    }
  });
</script>