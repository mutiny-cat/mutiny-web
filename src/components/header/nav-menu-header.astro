---
// Navegación horizontal para escritorio (≥1366px) con dropdowns en opciones con hijos
import { useTranslations } from "@i18n/utils";
import { defaultLang } from "@i18n/ui";
import { headerMenuOptions } from "@data/menu-options";
import MenuOption from "@components/ui/menu-item.astro";
import Dropdown from "./dropdown-header.astro";

export interface Props {
  lang?: "ca" | "es" | "en";
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

// Añade el prefijo de idioma a las URLs si no es el idioma por defecto
function localizeHref(href: string): string {
  if (lang === defaultLang) return href;
  return `/${lang}${href}`;
}
---

<!-- Navegación principal de escritorio: enlaces directos o con dropdown -->
<nav>
  <ul>
    {
      headerMenuOptions.map((opt) => {
        const label = t(opt.labelKey);

        // Opción con submenú: muestra el texto y un dropdown con los hijos
        if (opt.children && opt.children.length > 0) {
          return (
            <li>
              <MenuOption text={label} keyIndex={opt.keyIndex} />
              <Dropdown
                label={label}
                items={opt.children.map((child) => ({
                  text: child.separator ? undefined : t(child.labelKey),
                  href: child.href ? localizeHref(child.href) : undefined,
                  keyIndex: child.keyIndex,
                  separator: child.separator,
                }))}
              />
            </li>
          );
        }

        // Opción de enlace directo sin submenú
        return (
          <li>
            <MenuOption
              text={label}
              keyIndex={opt.keyIndex}
              href={opt.href ? localizeHref(opt.href) : undefined}
            />
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  /* Oculto en móvil/tablet, visible como flex en escritorio */
  nav {
    display: none;

    @media (min-width: 1366px) {
      display: block;

      /* Lista horizontal de opciones del menú */
      ul {
        display: flex;
        align-items: center;
      }
    }
  }
</style>
