---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import '../styles/global.css';
import { useTranslations } from '../i18n/utils';

export interface Props {
  title?: string;
  description?: string;
  lang?: 'ca' | 'es' | 'en';
}

const { lang = 'ca', description = "" } = Astro.props;
const t = useTranslations(lang);

const defaults: Record<string, string> = {
  ca: 'Mutiny — Turbo Edition',
  es: 'Mutiny — Turbo Edition',
};

const title = Astro.props.title || defaults[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    <div class="turbo-container">
      <Header lang={lang} title={title} />
      <main id="main-content" class="desktop" tabindex="-1">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    cursor: var(--cursor-dos);
  }
</style>

<style>
  .skip-link {
    position: absolute;
    top: -9999px;
    left: -9999px;
    z-index: 1000;
    background: #000;
    color: #fff;
    padding: 8px 16px;
    font-size: 16px;
    font-weight: 700;

    &:focus {
      top: 0;
      left: 0;
    }
  }

  .turbo-container {
    display: flex;
    flex-direction: column;
    block-size: 100vh;
  }

  .desktop {
    flex: 1;
    overflow: auto;
    position: relative;
    background-color: var(--light-gray);
    cursor: var(--cursor-dos-red);
    background-image:
      linear-gradient(45deg, var(--light-blue) 25%, transparent 25%),
      linear-gradient(-45deg, var(--light-blue) 25%, transparent 25%);
    background-size: 2px 2px;
    background-position: 0 0, 0 1px;

    &:focus {
      outline: none;
    }
  }

  .desktop a,
  .desktop a:link,
  .desktop a:visited,
  .desktop a:hover,
  .desktop a:active,
  .desktop button {
    cursor: var(--cursor-dos-red);
  }
</style>
