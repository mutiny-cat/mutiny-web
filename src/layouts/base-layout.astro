---
// Layout principal para la página home: fondo con patrón ASCII, sin bordes
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import ModalHome from "@components/modals/modal-home.astro";
import ModalMenu from "@components/modals/modal-menu.astro";
import ModalLanguages from "@components/modals/modal-languages.astro";
import "../styles/global.css";
import { useTranslations } from "@i18n/utils";

export interface Props {
  title?: string;
  description?: string;
  lang?: "ca" | "es" | "en";
}

const { lang = "ca", description = "" } = Astro.props;
const t = useTranslations(lang);

const defaults: Record<string, string> = {
  ca: "Mutiny — Turbo Edition",
  es: "Mutiny — Turbo Edition",
};

const title = Astro.props.title || defaults[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    <div class="turbo-container">
      <Header lang={lang} />
      <main id="main-content" class="desktop" tabindex="-1">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>

    <ModalHome lang={lang} />
    <ModalMenu lang={lang} />
    <ModalLanguages lang={lang} />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    cursor: default;
  }

  a,
  a:link,
  a:visited,
  a:hover,
  a:active,
  a *,
  button,
  button * {
    cursor: pointer;
  }
</style>

<style>
  .skip-link {
    position: absolute;
    top: -9999px;
    left: -9999px;
    z-index: 1000;
    background: #000;
    color: #fff;
    padding: 8px 16px;
    font-size: 16px;
    font-weight: 700;

    &:focus {
      top: 0;
      left: 0;
    }
  }

  .turbo-container {
    display: flex;
    flex-direction: column;
    block-size: 100vh;
  }

  .desktop {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    position: relative;
    cursor: var(--cursor-dos);
    background-color: var(--light-gray);
    color: var(--black);
    background-image: linear-gradient(
      45deg,
      var(--light-blue) 25%,
      transparent 25%
    );
    background-size: 3px 3px;

    &:focus {
      outline: none;
    }
  }

  .desktop a,
  .desktop a:link,
  .desktop a:visited,
  .desktop a:active,
  .desktop button {
    cursor: pointer;
  }
</style>
