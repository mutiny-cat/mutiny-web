---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
import { useTranslations } from "../i18n/utils";

export interface Props {
  title?: string;
  description?: string;
  lang?: "ca" | "es" | "en";
  variant?: "default" | "home";
}

const { lang = "ca", description = "", variant = "default" } = Astro.props;
const t = useTranslations(lang);

const defaults: Record<string, string> = {
  ca: "Mutiny — Turbo Edition",
  es: "Mutiny — Turbo Edition",
};

const title = Astro.props.title || defaults[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    <div class="turbo-container">
      <Header lang={lang} />
      <main
        id="main-content"
        class={`desktop desktop--${variant}`}
        tabindex="-1"
      >
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>

<style is:global>
  ::-webkit-scrollbar {
    width: 16px;
    border: 5px solid var(--white);
  }

  ::-webkit-scrollbar-thumb {
    background-color: var(--light-gray);
    background-clip: padding-box;
    border: 1px solid var(--border-light);
  }

  ::-webkit-scrollbar-track {
    background-color: var(--light-gray);
    background-image: linear-gradient(45deg, var(--light-blue) 25%, transparent 25%);
    background-size: 3px 3px;
  }

  ::-webkit-scrollbar-button:single-button {
    display: block;
    height: 16px;
    width: 16px;
  }

  ::-webkit-scrollbar-button:single-button:vertical:decrement {
    border-style: solid;
    border-width: 0 8px 8px 8px;
    border-color: transparent transparent var(--dark-gray) transparent;
  }

  ::-webkit-scrollbar-button:single-button:vertical:decrement:hover {
    border-color: transparent transparent var(--border-dark) transparent;
  }

  ::-webkit-scrollbar-button:single-button:vertical:increment {
    border-style: solid;
    border-width: 8px 8px 0 8px;
    border-color: var(--dark-gray) transparent transparent transparent;
  }

  ::-webkit-scrollbar-button:single-button:vertical:increment:hover {
    border-color: var(--border-dark) transparent transparent transparent;
  }
</style>

<style is:global>
  *,
  *::before,
  *::after {
    cursor: default;
  }

  a,
  a:link,
  a:visited,
  a:hover,
  a:active,
  button {
    cursor: pointer;
  }
</style>

<style>
  .skip-link {
    position: absolute;
    top: -9999px;
    left: -9999px;
    z-index: 1000;
    background: #000;
    color: #fff;
    padding: 8px 16px;
    font-size: 16px;
    font-weight: 700;

    &:focus {
      top: 0;
      left: 0;
    }
  }

  .turbo-container {
    display: flex;
    flex-direction: column;
    block-size: 100vh;
  }

  .desktop {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    position: relative;
    cursor: var(--cursor-dos);

    &:focus {
      outline: none;
    }
  }

  .desktop--default {
    background-color: var(--blue);
    color: var(--yellow);
  }

  .desktop--home {
    background-color: var(--light-gray);
    color: var(--black);
    background-image: linear-gradient(
      45deg,
      var(--light-blue) 25%,
      transparent 25%
    );
    background-size: 3px 3px;
  }

  .desktop a,
  .desktop a:link,
  .desktop a:visited,
  .desktop a:active,
  .desktop button {
    cursor: pointer;
  }
</style>
