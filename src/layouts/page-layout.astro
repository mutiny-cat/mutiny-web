---
// Layout para páginas de contenido: fondo azul con doble borde blanco y botón de cierre
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import CloseButton from "@components/ui/close-button.astro";
import ModalMenu from "@components/modals/modal-menu.astro";
import ModalLanguages from "@components/modals/modal-languages.astro";
import "../styles/global.css";
import { useTranslations } from "@i18n/utils";

export interface Props {
  title?: string;
  description?: string;
  lang?: "ca" | "es" | "en";
  windowTitle?: string;
}

const { lang = "ca", description = "", windowTitle = "" } = Astro.props;
const t = useTranslations(lang);

const defaults: Record<string, string> = {
  ca: "Mutiny — Turbo Edition",
  es: "Mutiny — Turbo Edition",
};

const title = Astro.props.title || defaults[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    <div class="turbo-container">
      <Header lang={lang} />
      <main id="main-content" class="desktop" tabindex="-1">
        <div class="main-border">
          <CloseButton top="8px" left="48px" />
          <span class="page-title">{windowTitle || "Título de la página"}.pas</span>
          <div class="main-container">
            <slot />
          </div>
        </div>
      </main>
      <Footer lang={lang} />
    </div>

    <ModalMenu lang={lang} />
    <ModalLanguages lang={lang} />
  </body>
</html>

<script>
  function toggleLangModal() {
    document.getElementById("lang-modal")?.classList.toggle("open");
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "F11") {
      e.preventDefault();
      toggleLangModal();
    }
  });

  document.querySelectorAll(".fx-button").forEach((btn) => {
    btn.addEventListener("click", toggleLangModal);
  });

  document.querySelectorAll("[data-close]").forEach((btn) => {
    btn.addEventListener("click", () => {
      btn.closest(".window")?.classList.remove("open");
    });
  });
</script>

<style>
  .skip-link {
    position: absolute;
    top: -9999px;
    left: -9999px;
    z-index: 1000;
    background: #000;
    color: #fff;
    padding: 8px 16px;
    font-size: 16px;
    font-weight: 700;

    &:focus {
      top: 0;
      left: 0;
    }
  }

  .turbo-container {
    display: flex;
    flex-direction: column;
    block-size: 100vh;
  }

  .desktop {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    position: relative;
    cursor: var(--cursor-dos);
    background-color: var(--blue);
    color: var(--yellow);
    padding: 16px;
    display: flex;
    flex-direction: column;

    &:focus {
      outline: none;
    }
  }

  .desktop a,
  .desktop a:link,
  .desktop a:visited,
  .desktop a:active,
  .desktop button {
    cursor: pointer;
  }

  .main-border {
    flex: 1;
    overflow-y: auto;
    border: 6px double var(--white);
    position: relative;
  }

  .main-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .page-title {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    font-weight: 700;
    color: var(--white);
    background: var(--blue);
    max-inline-size: fit-content;
    padding: 0 16px;
  }
</style>
