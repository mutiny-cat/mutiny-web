---
import BaseLayout from "../../layouts/base-layout.astro";
import { useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as "es" | "en");
---

<BaseLayout lang={lang as "es" | "en"} title={t("title.contacte")}>
  <article class="page" aria-labelledby="heading">
    <h1 id="heading" class="page-title">{t("contact.heading")}</h1>

    <p class="contact-intro">{t("contact.intro")}</p>

    <dl class="contact-list">
      <div class="contact-item">
        <dt class="contact-label">{t("contact.email")}</dt>
        <dd class="contact-value">
          <a href="mailto:hola@mutiny.cat">hola@mutiny.cat</a>
        </dd>
      </div>

      <div class="contact-item">
        <dt class="contact-label">{t("contact.github")}</dt>
        <dd class="contact-value">
          <a
            href="https://github.com/mutiny-cat"
            target="_blank"
            rel="noopener noreferrer"
          >
            github.com/mutiny-cat
          </a>
        </dd>
      </div>

      <div class="contact-item">
        <dt class="contact-label">{t("contact.linkedin")}</dt>
        <dd class="contact-value">
          <span class="contact-note">{t("contact.linkedin.note")}</span>
        </dd>
      </div>
    </dl>
  </article>
</BaseLayout>

<style>
  .contact-intro {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    margin-block-end: 48px;
    max-inline-size: 72ch;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    font-weight: 700;
    margin-block-end: 4px;
  }

  .contact-value {
    font-family: var(--font-mono);
    font-size: var(--font-size);
  }

  .contact-note {
    opacity: 0.75;
    font-style: italic;
  }
</style>
