---
import BaseLayout from "../../../layouts/base-layout.astro";
import { useTranslations } from "../../../i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as "es" | "en");
---

<BaseLayout lang={lang as "es" | "en"} title={t("title.projectes")}>
  <article class="page" aria-labelledby="heading">
    <h1 id="heading" class="page-title">{t("projects.heading")}</h1>

    <section class="section" aria-labelledby="web-heading">
      <h2 id="web-heading" class="section-title">{t("projects.web")}</h2>
      <p class="section-desc">{t("projects.web.desc")}</p>
      <ul class="list">
        <li>{t("projects.web.1")}</li>
        <li>{t("projects.web.2")}</li>
      </ul>
    </section>

    <section class="section" aria-labelledby="uxui-heading">
      <h2 id="uxui-heading" class="section-title">{t("projects.uxui")}</h2>
      <p class="section-desc">{t("projects.uxui.desc")}</p>
      <ul class="list">
        <li>{t("projects.uxui.1")}</li>
        <li>{t("projects.uxui.2")}</li>
      </ul>
    </section>

    <section class="section" aria-labelledby="grafic-heading">
      <h2 id="grafic-heading" class="section-title">{t("projects.grafic")}</h2>
      <p class="section-desc">{t("projects.grafic.desc")}</p>
      <ul class="list">
        <li>{t("projects.grafic.1")}</li>
        <li>{t("projects.grafic.2")}</li>
      </ul>
    </section>
  </article>
</BaseLayout>
