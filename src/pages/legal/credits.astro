---
import PageLayout from "../../layouts/base-layout.astro";
import { useTranslations } from "../../i18n/utils";
const t = useTranslations("ca");
---

<PageLayout lang="ca" title="Mutiny — Crèdits" windowTitle={t("nav.legal")}>
  <article class="page" aria-labelledby="heading">
    <h1 id="heading" class="page-title">{t("legal.credits.heading")}</h1>
    <p class="section-desc">{t("legal.credits.p1")}</p>
    <p class="section-desc">{t("legal.credits.p2")}</p>
    <p class="section-desc">{t("legal.credits.stucom")}</p>
    <p class="section-desc">{t("legal.credits.fib")}</p>
    <p class="section-desc">{t("legal.credits.p3")}</p>
  </article>
</PageLayout>

<style>
  .page-title {
    font-family: var(--font-mono);
    font-size: clamp(28px, 4vw, 48px);
    margin-block-end: 32px;
  }

  .section-desc {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    margin-block-end: 24px;
    max-inline-size: 72ch;
  }
</style>
