---
import BaseLayout from '../../layouts/base-layout.astro';
import { useTranslations } from '../../i18n/utils';
const t = useTranslations('ca');
---

<BaseLayout lang="ca" title="Mutiny — Avís legal">
  <article class="page" aria-labelledby="heading">
    <h1 id="heading" class="page-title">{t('legal.avis.heading')}</h1>
    <p class="section-desc">{t('legal.avis.p1')}</p>
    <p class="section-desc">{t('legal.avis.p2')}</p>
  </article>
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-mono);
    font-size: clamp(28px, 4vw, 48px);
    margin-block-end: 32px;
  }

  .section-desc {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    line-height: 1.6;
    margin-block-end: 24px;
    max-inline-size: 72ch;
  }
</style>
