---
import BaseLayout from "../layouts/base-layout.astro";
import { useTranslations } from "../i18n/utils";
const t = useTranslations("ca");
---

<BaseLayout lang="ca">
</BaseLayout>

<script>
  const lang = localStorage.getItem("lang");
  if (lang && lang !== "ca") {
    window.location.href = `/${lang}/`;
  }
</script>
