---
import PageLayout from "@layouts/page-layout.astro";
import { useTranslations } from "@i18n/utils";
const t = useTranslations("ca");
---

<PageLayout lang="ca" title={t("title.sobre")} windowTitle={t("nav.sobre")}>
  <article class="page" aria-labelledby="heading">
    <h1 id="heading" class="page-title">{t("about.heading")}</h1>

    <section class="section" id="biografia" aria-labelledby="bio-heading">
      <h2 id="bio-heading" class="section-title">{t("about.bio.heading")}</h2>
      <p class="section-desc">{t("about.bio.p2")}</p>
      <p class="section-desc">{t("about.bio.p1")}</p>
    </section>

    <section class="section" id="cronologia" aria-labelledby="timeline-heading">
      <h2 id="timeline-heading" class="section-title">
        {t("about.timeline.heading")}
      </h2>
      <ul class="list timeline">
        <li>{t("about.timeline.1")}</li>
        <li>{t("about.timeline.2")}</li>
        <li>{t("about.timeline.3")}</li>
        <li>{t("about.timeline.4")}</li>
        <li>{t("about.timeline.5")}</li>
        <li>{t("about.timeline.6")}</li>
        <li>{t("about.timeline.7")}</li>
        <li>{t("about.timeline.8")}</li>
        <li>{t("about.timeline.9")}</li>
        <li>{t("about.timeline.10")}</li>
        <li>{t("about.timeline.11")}</li>
        <li>{t("about.timeline.12")}</li>
        <li>{t("about.timeline.13")}</li>
        <li>{t("about.timeline.14")}</li>
        <li>{t("about.timeline.15")}</li>
        <li>{t("about.timeline.16")}</li>
        <li>{t("about.timeline.17")}</li>
        <li>{t("about.timeline.18")}</li>
        <li>{t("about.timeline.19")}</li>
        <li>{t("about.timeline.20")}</li>
        <li>{t("about.timeline.21")}</li>
        <li>{t("about.timeline.22")}</li>
        <li>{t("about.timeline.23")}</li>
        <li>{t("about.timeline.24")}</li>
        <li>{t("about.timeline.25")}</li>
      </ul>
    </section>

    <section class="section" id="cv" aria-labelledby="cv-heading">
      <h2 id="cv-heading" class="section-title">{t("about.cv.heading")}</h2>
      <p class="section-desc">{t("about.cv.intro")}</p>
      <a href="/recursos/cv/" class="cv-link">
        {t("about.cv.download")}
      </a>
    </section>

    <section class="section" id="referents" aria-labelledby="ref-heading">
      <h2 id="ref-heading" class="section-title">
        {t("about.referents.heading")}
      </h2>
      <p class="section-desc">{t("about.referents.p1")}</p>

      <h3 class="ref-heading">{t("about.referents.devs")}</h3>
      <ul class="list">
        <li>{t("about.referents.devs.1")}</li>
        <li>{t("about.referents.devs.2")}</li>
        <li>{t("about.referents.devs.3")}</li>
        <li>{t("about.referents.devs.4")}</li>
      </ul>

      <h3 class="ref-heading">{t("about.referents.uxui")}</h3>
      <ul class="list">
        <li>{t("about.referents.uxui.1")}</li>
        <li>{t("about.referents.uxui.2")}</li>
        <li>{t("about.referents.uxui.3")}</li>
        <li>{t("about.referents.uxui.4")}</li>
      </ul>

      <h3 class="ref-heading">{t("about.referents.micro")}</h3>
      <ul class="list">
        <li>{t("about.referents.micro.1")}</li>
      </ul>

      <h3 class="ref-heading">{t("about.referents.graphic")}</h3>
      <ul class="list">
        <li>{t("about.referents.graphic.1")}</li>
        <li>{t("about.referents.graphic.2")}</li>
      </ul>
    </section>
  </article>
</PageLayout>

<style>
  .page-title {
    font-family: var(--font-mono);
    font-size: clamp(28px, 4vw, 48px);
    margin-block-end: 48px;
  }

  .section {
    margin-block-end: 48px;
    scroll-margin-block-start: 16px;
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: clamp(20px, 2.5vw, 28px);
    margin-block-end: 16px;
    border-block-end: 1px solid var(--yellow);
    padding-block-end: 8px;
  }

  .section-desc {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    margin-block-end: 16px;
    max-inline-size: 72ch;
  }

  .list {
    list-style: none;
    padding: 0;
  }

  .list li {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    padding-inline-start: 24px;
    position: relative;
  }

  .list li::before {
    content: ">";
    position: absolute;
    inset-inline-start: 0;
    color: var(--yellow);
  }

  .timeline li {
    padding-block: 4px;
  }

  .cv-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--font-size);
    padding: 16px 32px;
    border: 2px solid var(--yellow);
    text-decoration: none;
  }

  .cv-link:hover {
    background: var(--yellow);
    color: var(--blue);
    text-decoration: none;
  }

  .ref-heading {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    font-weight: 700;
    margin-block: 16px 8px;
  }
</style>
