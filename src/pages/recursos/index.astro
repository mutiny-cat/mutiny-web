---
import PageLayout from "../../layouts/base-layout.astro";
import { useTranslations } from "../../i18n/utils";
const t = useTranslations("ca");
---

<PageLayout lang="ca" title={t("title.recursos")} windowTitle={t("nav.recursos")}>
  <article class="page" aria-labelledby="heading">
    <h1 id="heading" class="page-title">{t("resources.heading")}</h1>

    <section class="section" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="section-title">{t("resources.tools")}</h2>
      <p class="section-desc">{t("resources.tools.intro")}</p>
      <ul class="list">
        <li>{t("resources.tools.1")}</li>
        <li>{t("resources.tools.2")}</li>
        <li>{t("resources.tools.3")}</li>
        <li>{t("resources.tools.4")}</li>
      </ul>
    </section>

    <section class="section" aria-labelledby="docs-heading">
      <h2 id="docs-heading" class="section-title">{t("resources.docs")}</h2>
      <p class="section-desc">{t("resources.docs.intro")}</p>
      <ul class="list">
        <li>{t("resources.docs.1")}</li>
        <li>{t("resources.docs.2")}</li>
        <li>{t("resources.docs.3")}</li>
        <li>{t("resources.docs.4")}</li>
      </ul>
    </section>
  </article>
</PageLayout>

<style>
  .page-title {
    font-family: var(--font-mono);
    font-size: clamp(28px, 4vw, 48px);
    margin-block-end: 48px;
  }

  .section {
    margin-block-end: 48px;
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: clamp(20px, 2.5vw, 28px);
    margin-block-end: 16px;
    border-block-end: 1px solid var(--yellow);
    padding-block-end: 8px;
  }

  .section-desc {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    margin-block-end: 16px;
    max-inline-size: 72ch;
  }

  .list {
    list-style: none;
    padding: 0;
  }

  .list li {
    font-family: var(--font-mono);
    font-size: var(--font-size);
    padding-inline-start: 24px;
    position: relative;
  }

  .list li::before {
    content: ">";
    position: absolute;
    inset-inline-start: 0;
    color: var(--yellow);
  }
</style>
